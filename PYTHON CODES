        "column": df.columns,
        "data_type": df.dtypes.astype(str).values,
        "missing_values": df.isnull().sum().values,
        "unique_values": df.nunique().values,
    })

    report["missing_percent"] = (
        report["missing_values"] / max(len(df), 1) * 100
    )

    print(f"\nDATA QUALITY REPORT: {name}")
